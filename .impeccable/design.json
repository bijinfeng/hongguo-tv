      "html": "<button type=\"button\" class=\"ds-button\">继续观看</button>",
      "css": ".ds-button{--ds-card:#ffffff;--ds-foreground:#20211f;--ds-primary:#c52e39;--ds-primary-foreground:#ffffff;--ds-accent:#fbe8e9;--ds-border:#dedfd9;--ds-input:#d0d2cb;--ds-ring:#b42130;--ds-muted:#efefed;--ds-muted-foreground:#686a64;--ds-background:#f8f8f7;}@media(prefers-color-scheme:dark){.ds-button{--ds-card:#20231f;--ds-foreground:#f3f4ef;--ds-primary:#f2777d;--ds-primary-foreground:#311216;--ds-accent:#42282a;--ds-border:#383e35;--ds-input:#50584a;--ds-ring:#ffa6ab;--ds-muted:#292d27;--ds-muted-foreground:#a6ada0;--ds-background:#161816;}}.ds-button{min-height:48px;padding:12px 16px;border:2px solid var(--ds-border);border-radius:12px;background:var(--ds-card);color:var(--ds-foreground);font:400 16px system-ui,sans-serif;display:inline-flex;justify-content:center;align-items:center;cursor:pointer;}.ds-button:hover:not(:disabled){background:var(--ds-accent);}.ds-button:focus-visible{outline:none;border-color:var(--ds-ring);}.ds-button:active:not(:disabled){opacity:.7;}.ds-button:disabled{opacity:.4;cursor:default;}"
