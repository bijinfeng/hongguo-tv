    "/minireel-proxy/media/{token}": {
      "get": {
        "tags": [
          "playback"
        ],
        "operationId": "media",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Opaque handle",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "One byte range",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "video/mp4 bytes"
          },
          "206": {
            "description": "Partial video/mp4 bytes"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
