  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "Machine-readable errors keep human copy independent of client branching.",
        "required": [
          "ok",
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable error code."
          },
          "error": {
            "type": "string",
            "description": "Human-readable description."
          },
          "ok": {
            "type": "boolean",
            "description": "Always false."
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "description": "Implemented capabilities, shared by every transport.",
        "required": [
          "search",
          "playback",
          "account",
          "history"
        ],
        "properties": {
          "account": {
            "type": "boolean",
            "description": "Persistent account and history are available."
          },
          "history": {
            "type": "boolean",
            "description": "Persistent guest history is attached by the host."
          },
          "playback": {
            "type": "boolean",
            "description": "Real media resolution and streaming are available."
          },
          "search": {
            "type": "boolean",
            "description": "Real content search is available."
          }
        }
      },
      "CoreStatus": {
        "type": "object",
        "description": "Runtime readiness is separate from content migration progress.",
        "required": [
          "api_version",
          "version",
          "capabilities"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "description": "Version of the wire contract."
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities",
            "description": "Available product functions."
          },
          "version": {
            "type": "string",
            "description": "Build version."
          }
        }
      },
      "DetailResponse": {
        "type": "object",
        "description": "Successful ordinary drama detail.",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Drama",
            "description": "Requested drama and ordered episodes."
          },
          "ok": {
            "type": "boolean",
            "description": "Always true."
          }
        }
      },
      "DiscoveryBoard": {
        "type": "object",
        "description": "One nonempty public board.",
        "required": [
          "id",
          "items"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DiscoveryBoardKind",
            "description": "Stable content family."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiscoveryItem"
            },
            "description": "At most six unique playable summaries."
          }
        }
      },
      "DiscoveryBoardKind": {
        "type": "string",
        "description": "The only accepted public video-board families.",
        "enum": [
          "short",
          "comic"
        ]
      },
      "DiscoveryItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Drama",
            "description": "Summary fields; series_id is empty for a keyword-only suggestion."
          },
          {
            "type": "object",
            "properties": {
              "position": {
                "type": "integer",
                "format": "int32",
                "description": "Original one-based position before filtering and deduplication.",
                "minimum": 0
              },
              "query": {
                "type": "string",
                "description": "Search term only, never an inferred playable ID from a tag."
              },
              "search_score": {
                "type": "string",
                "description": "Bounded official popularity display text."
              }
            }
          }
        ],
        "description": "A display summary or an explicitly nonplayable keyword-only suggestion."
      },
      "DiscoveryResponse": {
        "type": "object",
        "description": "Successful anonymous public discovery snapshot.",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SearchDiscovery",
            "description": "Bounded public suggestions and boards."
          },
          "ok": {
            "type": "boolean",
            "description": "Always true."
          }
        }
      },
      "Drama": {
        "type": "object",
        "description": "Shared drama summary; detail adds ordered episodes without leaking upstream payloads.",
        "required": [
          "series_id",
          "title",
          "cover",
          "intro"
        ],
        "properties": {
          "content_type": {
            "type": "string",
            "description": "Content family; creator albums are outside this service."
          },
          "cover": {
            "type": "string",
            "description": "Original cover address."
          },
          "cover_fallback": {
            "type": "string",
            "description": "Website JPEG alternative for supported HEIC covers."
          },
          "episode_count": {
            "type": "integer",
            "format": "int32",
            "description": "Reported episode count.",
            "minimum": 0
          },
          "episodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Episode"
            },
            "description": "Ordered detail episodes; absent in search summaries."
          },
          "intro": {
            "type": "string",
            "description": "Plain description."
          },
          "series_id": {
            "type": "string",
            "description": "Exact series identifier."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Genre labels."
          },
          "title": {
            "type": "string",
            "description": "Display title."
          }
        }
      },
      "Entry": {
        "type": "object",
        "description": "Compact saved progress, compatible with shared history clients.",
        "required": [
          "drama"
        ],
        "properties": {
          "completed": {
            "type": "boolean",
            "description": "Whether this episode finished."
          },
          "drama": {
            "$ref": "#/components/schemas/Drama",
            "description": "Summary without episode arrays."
          },
          "duration": {
            "type": "number",
            "format": "double",
            "description": "Duration in seconds."
          },
          "episode": {
            "type": "integer",
            "format": "int32",
            "description": "One-based episode number.",
            "minimum": 0
          },
          "last_played_at": {
            "type": "integer",
            "format": "int64",
            "description": "Server-assigned committed viewing time in milliseconds."
          },
          "position": {
            "type": "number",
            "format": "double",
            "description": "Playback position in seconds."
          },
          "video_id": {
            "type": "string",
            "description": "Exact current video ID."
          }
        }
      },
      "Episode": {
        "type": "object",
        "description": "Episode identity and access state; indexes are one-based.",
        "required": [
          "index",
          "video_id",
          "locked"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32",
            "description": "One-based episode number.",
            "minimum": 0
          },
          "locked": {
            "type": "boolean",
            "description": "Whether the episode is outside the website's accessible range."
          },
          "title": {
            "type": "string",
            "description": "Optional display title."
          },
          "video_id": {
            "type": "string",
            "description": "Exact upstream video identifier, never a floating-point number."
          }
        }
      },
      "HistoryChange": {
        "oneOf": [
          {
            "type": "object",
            "description": "An explicit playback checkpoint. Media resolution alone never writes it.",
            "required": [
              "drama",
              "episode",
              "video_id",
              "position",
              "duration",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "progress"
                ]
              },
              "completed": {
                "type": "boolean",
                "description": "Defaults to unfinished."
              },
              "drama": {
                "$ref": "#/components/schemas/Drama",
                "description": "Drama identity and display summary."
              },
              "duration": {
                "type": "number",
                "format": "double",
                "description": "Finite seconds, 0–86400."
              },
              "episode": {
                "type": "integer",
                "format": "int32",
                "description": "One-based episode, 1–10000.",
                "minimum": 0
              },
              "owner_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Expected library owner; absent or empty for guests."
              },
              "position": {
                "type": "number",
                "format": "double",
                "description": "Finite seconds, 0–86400."
              },
              "video_id": {
                "type": "string",
                "description": "Nonzero decimal video ID, up to 32 digits."
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "Remove one history item; repeating it is harmless.",
            "required": [
              "kind",
              "series_id",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "remove"
                ]
              },
              "kind": {
                "$ref": "#/components/schemas/HistoryKind",
                "description": "Only history is migrated."
              },
              "owner_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Expected owner, empty for guests."
              },
              "series_id": {
                "type": "string",
                "description": "Exact series ID."
              }
            }
          },
          {
            "type": "object",
            "description": "Clear guest watch history.",
            "required": [
              "kind",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "clear"
                ]
              },
              "kind": {
                "$ref": "#/components/schemas/HistoryKind",
                "description": "Only history is migrated."
              },
              "owner_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Expected owner, empty for guests."
              }
            }
          }
        ],
        "description": "Strict, explicit history mutations; favorites and likes remain unavailable."
      },
      "HistoryKind": {
        "type": "string",
        "description": "The only migrated record category.",
        "enum": [
          "history"
        ]
      },
      "Library": {
        "type": "object",
        "description": "Guest history snapshot; account-backed libraries are not yet implemented.",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            },
            "description": "Most recently viewed first."
          },
          "owner_id": {
            "type": "string",
            "description": "Empty for guests; optional for compatibility with existing clients."
          }
        }
      },
      "LibraryResponse": {
        "type": "object",
        "description": "Committed guest history using the shared envelope.",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Library",
            "description": "Persisted snapshot."
          },
          "ok": {
            "type": "boolean",
            "description": "Always true."
          }
        }
      },
      "PlayInfo": {
        "type": "object",
        "description": "Prepared local resource; never contains upstream addresses, keys or device IDs.",
        "required": [
          "path",
          "vid",
          "video_codec",
          "quality",
          "qualities"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Same-service opaque media route."
          },
          "qualities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Distinct resolutions available from this accepted source."
          },
          "quality": {
            "type": "string",
            "description": "Actual selected resolution."
          },
          "vid": {
            "type": "string",
            "description": "Selected episode video ID."
          },
          "video_codec": {
            "type": "string",
            "description": "Actual media codec; vendor bytevc2 is not supported."
          }
        }
      },
      "PlayResponse": {
        "type": "object",
        "description": "Media prepared by the core; contains no upstream secrets.",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PlayInfo",
            "description": "Episode-bound local media resource."
          },
          "ok": {
            "type": "boolean",
            "description": "Always true."
          }
        }
      },
      "Progress": {
        "type": "object",
        "description": "An explicit playback checkpoint. Media resolution alone never writes it.",
        "required": [
          "drama",
          "episode",
          "video_id",
          "position",
          "duration"
        ],
        "properties": {
          "completed": {
            "type": "boolean",
            "description": "Defaults to unfinished."
          },
          "drama": {
            "$ref": "#/components/schemas/Drama",
            "description": "Drama identity and display summary."
          },
          "duration": {
            "type": "number",
            "format": "double",
            "description": "Finite seconds, 0–86400."
          },
          "episode": {
            "type": "integer",
            "format": "int32",
            "description": "One-based episode, 1–10000.",
            "minimum": 0
          },
          "owner_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Expected library owner; absent or empty for guests."
          },
          "position": {
            "type": "number",
            "format": "double",
            "description": "Finite seconds, 0–86400."
          },
          "video_id": {
            "type": "string",
            "description": "Nonzero decimal video ID, up to 32 digits."
          }
        },
        "additionalProperties": false
      },
      "ReleaseRequest": {
        "type": "object",
        "description": "Release a previously issued local playback path.",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Exact local path returned by play/info."
          }
        },
        "additionalProperties": false
      },
      "ReleaseResponse": {
        "type": "object",
        "description": "Successful idempotent release.",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReleaseResult",
            "description": "Acknowledgment, including already expired resources."
          },
          "ok": {
            "type": "boolean",
            "description": "Always true."
          }
        }
      },
      "ReleaseResult": {
        "type": "object",
        "description": "Release acknowledgment.",
        "required": [
          "released"
        ],
        "properties": {
          "released": {
            "type": "boolean",
            "description": "Always true after accepting a valid local path."
          }
        }
      },
      "SearchDiscovery": {
        "type": "object",
        "description": "Public search-page snapshot; empty arrays are a valid optional result.",
        "required": [
          "guesses",
          "boards"
        ],
        "properties": {
          "boards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiscoveryBoard"
            },
            "description": "Nonempty boards in short, comic order."
          },
          "guesses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiscoveryItem"
            },
            "description": "At most four public suggestions; keyword-only rows have query and no series identity."
          }
        }
      },
      "SearchHistory": {
        "type": "object",
        "description": "Committed recent keywords, newest first and at most ten.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Normalized, unique submitted keywords."
          }
        }
      },
      "SearchHistoryChange": {
        "oneOf": [
          {
            "type": "object",
            "description": "Save a submitted keyword, moving an existing keyword to the front.",
            "required": [
              "query",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "add"
                ]
              },
              "query": {
                "type": "string",
                "description": "Nonempty keyword within the website and UTF-16 limits."
              }
            }
          },
          {
            "type": "object",
            "description": "Remove keywords without changing viewing history.",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "clear"
                ]
              }
            }
          }
        ],
        "description": "Explicit device-local keyword mutation."
      },
      "SearchHistoryResponse": {
        "type": "object",
        "description": "Committed device-local keyword snapshot.",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SearchHistory",
            "description": "Newest keywords first."
          },
          "ok": {
            "type": "boolean",
            "description": "Always true."
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "description": "Successful website search page.",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SearchResult",
            "description": "Normalized website page."
          },
          "ok": {
            "type": "boolean",
            "description": "Always true."
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "description": "Website page result; continuation offsets count pages already consumed.",
        "required": [
          "items",
          "has_more",
          "next_offset"
        ],
        "properties": {
          "has_more": {
            "type": "boolean",
            "description": "Whether a further website page is available."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Drama"
            },
            "description": "Unique drama summaries, including an empty array for no matches."
          },
          "next_offset": {
            "type": "integer",
            "format": "int32",
            "description": "Consumed website page number; send as the next offset.",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "description": "Catalog source. Optional for legacy fixture compatibility; this service always emits web."
          }
        }
      },
      "SearchSuggestion": {
        "type": "object",
        "description": "One bounded display/action summary, without arbitrary upstream objects or detail episodes.",
        "required": [
          "kind",
          "key",
          "name"
        ],
        "properties": {
          "actor_id": {
            "type": "string",
            "description": "Exact nonzero decimal actor ID, if supplied for an actor item."
          },
          "drama": {
            "$ref": "#/components/schemas/Drama",
            "description": "Present only for a supported, explicitly identified drama-name result."
          },
          "key": {
            "type": "string",
            "description": "Bounded upstream key, falling back to name; never infer a series ID from this field."
          },
          "kind": {
            "$ref": "#/components/schemas/SuggestionKind",
            "description": "Distinct action meaning; only a drama-name item can carry drama."
          },
          "meta": {
            "type": "string",
            "description": "Bounded upstream categories, heat label and episode count, without invented popularity."
          },
          "name": {
            "type": "string",
            "description": "Plain display name and the term for ordinary keyword search."
          }
        }
      },
      "SearchSuggestions": {
        "type": "object",
        "description": "At most ten unique suggestions, preserving upstream order.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchSuggestion"
            },
            "description": "Empty when the current term is empty or the upstream has no valid suggestions."
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "description": "Successful status result using the shared response envelope.",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CoreStatus",
            "description": "Core state."
          },
          "ok": {
            "type": "boolean",
            "description": "Successful request."
          }
        }
      },
      "SuggestionKind": {
        "type": "string",
        "description": "Closed suggestion meanings; unknown upstream kinds become ordinary keyword search.",
        "enum": [
          "short_play_name",
          "short_play_actor",
          "common_query"
        ]
      },
      "SuggestionsResponse": {
        "type": "object",
        "description": "Successful anonymous current-term suggestions.",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SearchSuggestions",
            "description": "Bounded typed suggestions; empty terms do not access the upstream."
          },
          "ok": {
            "type": "boolean",
            "description": "Always true."
          }
        }
      }
    }
  }
}
