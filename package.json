{
  "name": "hongguo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node tooling/src/cli.mjs setup",
    "doctor": "node tooling/src/cli.mjs doctor",
    "dev": "node tooling/src/cli.mjs dev --target desktop",
    "dev:web": "node tooling/src/cli.mjs dev --target web",
    "dev:desktop": "node tooling/src/cli.mjs dev --target desktop",
    "dev:tv": "node tooling/src/cli.mjs dev --target tv",
    "dev:api": "node tooling/src/cli.mjs api",
    "fmt": "node tooling/src/cli.mjs fmt",
    "fmt:check": "node tooling/src/cli.mjs fmt:check",
    "lint": "node tooling/src/cli.mjs lint",
    "check": "node tooling/src/cli.mjs check",
    "build": "node tooling/src/cli.mjs build",
    "test": "node tooling/src/cli.mjs test",
    "test:tooling": "node --test tooling/test/*.test.mjs",
    "test:tv-emulator": "node tooling/src/tv-emulator.mjs",
    "verify": "node tooling/src/cli.mjs verify && node tooling/src/release.mjs check",
    "security": "node tooling/src/cli.mjs security",
    "codegen": "node tooling/src/codegen.mjs",
    "codegen:check": "node tooling/src/codegen.mjs --check",
    "package:web": "node tooling/src/cli.mjs package --target web",
    "package:desktop": "node tooling/src/cli.mjs package --target desktop",
    "package:tv": "node tooling/src/cli.mjs package --target tv",
    "release:check": "node tooling/src/release.mjs check",
    "release:sync": "node tooling/src/release.mjs sync",
    "release:metadata": "node tooling/src/release.mjs metadata",
    "release:record": "node tooling/src/release.mjs record",
    "release:verify-record": "node tooling/src/release.mjs verify-record",
    "hooks:install": "lefthook install",
    "hooks:check": "node tooling/src/hooks.mjs",
    "commitlint": "commitlint",
    "legacy:setup": "node scripts/setup.mjs",
    "legacy:dev": "node scripts/dev.mjs",
    "legacy:dev:web": "node scripts/dev.mjs --target web",
    "legacy:verify": "node scripts/nsh.mjs check && node scripts/nsh.mjs build && node --test scripts/*.test.mjs && node scripts/nsh.mjs test && go -C upstream/hongguo test ./core/cmd/hongguotv",
    "upstream:sync": "node scripts/sync-upstream.mjs",
    "setup:tools": "node tooling/src/cli.mjs setup:tools",
    "coverage": "node tooling/src/cli.mjs coverage",
    "test:rust": "node tooling/src/cli.mjs test:rust",
    "fuzz": "node tooling/src/fuzz.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "packageManager": "pnpm@11.1.3"
}
